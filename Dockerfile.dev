FROM debian:bookworm-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg git libicu72 \
        && install -m 0755 -d /etc/apt/keyrings \
        && curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
        && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian bookworm stable" > /etc/apt/sources.list.d/docker.list \
        && apt-get update \
        && apt-get install -y docker-ce-cli \
        && rm -rf /var/lib/apt/lists/*

# The compiled `ions` binary is bind-mounted at runtime; no build step here
# so the image rebuilds instantly when source changes on the host.
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/ions"]
